{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Codex Float Window Probe",
  "version": "0.1.0",
  "identifier": "dev.codexfloat.window-probe",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Codex Float Window Probe",
        "width": 250,
        "height": 64,
        "minWidth": 250,
        "minHeight": 64,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false
  }
}
